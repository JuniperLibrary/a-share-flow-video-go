OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=qwen3.5-flash、qwen3.5-plus、qwen3.5-122b-a10b、deepseek-v4-pro、qwen3.6-max-preview、kimi-k2.6、qwen3.7-max-2026-05-17

# Per-module 模型覆盖（可选，不设则用上面的 AI_MODEL 默认值）
# AI_MODEL_CLSNEWS=qwen-turbo          # 新闻分类：快+便宜，低延迟
# AI_MODEL_ANALYZER=gpt-4o              # 单日事件分析：强推理
# AI_MODEL_ANALYZER_MULTIDAY=gpt-4o     # 多日事件分析：更强的多日趋势推理
# AI_MODEL_TICK=gpt-4o-mini             # Tick 辅助分析：够用即可
# AI_MODEL_COPY=qwen3.6-plus            # 口播文案：中文好
# AI_MODEL_REPORT=gpt-4o                # 日报主题分析：深度金融分析
# AI_MODEL_TTS=gpt-4o-mini              # TTS 语音脚本：快速
# AI_MODEL_DEBATE=gpt-4o                # 辩论脚本：角色扮演、多轮推理

# CORS 配置（跨域部署时需要）
# 设置允许访问的前端域名，多个域名用逗号分隔
# 例如: CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com
CORS_ALLOWED_ORIGINS=